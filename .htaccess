# revalidate the page on each visit; assets keep their normal cache lifetime.
<FilesMatch "^(index|redwoods|forest|temple|monolith)\.html$">
  <IfModule mod_expires.c>
    ExpiresActive Off
  </IfModule>
  <IfModule mod_headers.c>
    Header always set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</FilesMatch>
